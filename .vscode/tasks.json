{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FK : télécharger les outils et JAR vérifiés",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/bootstrap.ps1"],
      "problemMatcher": []
    },
    {
      "label": "FK : compiler et tester Java",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "FK : tester la maintenance",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONUTF8": "1"}},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "FK : démarrer le serveur local",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/server.ps1", "start"],
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}
